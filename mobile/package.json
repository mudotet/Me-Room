{
  "name": "me-room",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./tests/register-expo-mock.mjs --test tests/*.test.mjs",
    "test:api": "node --import tsx scripts/test-api.mjs",
    "export:web": "expo export --platform web --output-dir dist/web",
    "export:ios": "expo export --platform ios --output-dir dist/ios"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-three/fiber": "^9.8.2",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-gl": "~58.0.4",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-screen-orientation": "~58.0.4",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.0",
    "three": "^0.183.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/three": "^0.183.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
